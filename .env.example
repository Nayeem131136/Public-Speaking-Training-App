# Copy this file to .env and change what you need. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-text-at-least-32-characters
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Addresses of the frontend (comma separated). Only these can call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# auto = use Whisper if it is installed, otherwise the mock. Other values: faster-whisper, mock
TRANSCRIBER=auto

# 1 = process the upload inside the request (easier to debug). 0 = background thread.
PROCESS_SYNC=0

# Whisper options (only used with the real engine)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Rate limits
UPLOAD_RATE=60/hour
LOGIN_RATE=20/minute
REGISTER_RATE=30/hour

# Passwords for the demo accounts (python manage.py seed_demo --users)
DEMO_ADMIN_PASSWORD=Admin@Backstage2026
DEMO_USER_PASSWORD=Demo@Backstage2026
